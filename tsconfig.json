{
  "compilerOptions": {
    "lib": ["ES2021"],
    "target": "ES2020",
		"moduleDetection": "force",
		"module": "Preserve",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"isolatedModules": true,
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": false,
    "baseUrl": ".",
    "paths": {
      "@command": ["command"],
      "@consensus": ["consensus"],
      "@configs": ["configs"],
      "@contracts": ["contracts"],
      "@providers": ["providers"],
      "@scripts": ["scripts"],
      "@utils": ["utils"]
    }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
